{
    admin off
}

# Works on http://localhost or auto-provisions SSL for your domain
{$DOMAIN:localhost} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    handle /api/* {
        request_body {
            max_size 50MB
        }
        reverse_proxy backend:8000 {
            # Disable buffering so AI Copilot tokens stream with zero delay
            flush_interval -1

            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}

            transport http {
                read_timeout 600s
                write_timeout 600s
            }
        }
    }

    handle /health {
        reverse_proxy backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    handle /docs* {
        reverse_proxy backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    handle /openapi.json {
        reverse_proxy backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    handle /ws/* {
        reverse_proxy browser-bridge:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up Upgrade {http.upgrade}
            header_up Connection {http.connection}

            transport http {
                read_timeout 86400s
                write_timeout 86400s
            }
        }
    }

    handle {
        root * /srv
        # Cache hashed production bundles for 1 year
        @static path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2
        header @static Cache-Control "public, max-age=31536000, immutable"

        # SPA router fallback: serve index.html for all client-side routes (/chat, /mission, etc.)
        try_files {path} /index.html
        file_server
    }
}