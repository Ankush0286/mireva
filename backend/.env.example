APP_NAME="Mireva"
DEBUG=false

# Database Configuration (PostgreSQL)
# IMPORTANT (Docker + Supabase): Use the IPv4-compatible Session Pooler URI (pooler.supabase.com:5432),
# NOT the IPv6-only Direct Connection (db.<ref>.supabase.co). Must start with postgresql+asyncpg://
DATABASE_URL="postgresql+asyncpg://postgres:your_password@localhost:5432/postgres"

# Database Connection Pool Settings
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# Master Vault Encryption Key (AES-128 Fernet)
SECRET_KEY="replace-with-your-32-byte-base64-fernet-key="

# AI Model Gateways (At least one required)
OPENROUTER_API_KEY="sk-or-v1-..."
FIREWORKS_API_KEY="fw_..."