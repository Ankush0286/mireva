
# Application Environment (development, staging, production)
ENVIRONMENT="production"
DEBUG=false
API_VERSION="/api/v1"
APP_NAME="Mireva"

# ----------------- Database Configuration (PostgreSQL / Supabase) -----------------
DATABASE_URL="postgresql+asyncpg://postgres:your_password@localhost:5432/postgres"

# Connection Pool Settings
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# ----------------- Security & Credential Vault -----------------
SECRET_KEY="replace-with-a-secure-32-byte-base64-key="

# ----------------- AI Model Gateways (At least one required) -----------------
OPENROUTER_API_KEY="sk-or-v1-..."
FIREWORKS_API_KEY="fw_..."

# Default Runtime Models
AGENT_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"
AGENT_REASONING_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"